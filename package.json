{
  "name": "gleam-wallet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --filter @gleam/extension exec wxt",
    "wxt:build": "pnpm --filter @gleam/extension exec wxt build",
    "check:bundles": "node scripts/check-bundles.mjs",
    "mobile:build": "pnpm --filter @gleam/mobile build",
    "mobile:ios": "pnpm --filter @gleam/mobile ios",
    "mobile:android": "pnpm --filter @gleam/mobile android",
    "mobile:android:wifi": "pnpm --filter @gleam/mobile android:wifi",
    "test:smoke": "playwright test",
    "eslint": "eslint",
    "deps:check": "depcruise packages apps/extension/src apps/extension/entrypoints apps/mobile/src apps/points-api/src --output-type err",
    "vitest": "vitest",
    "tsc": "tsc",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release-gate.mjs",
    "release:pack": "scripts/pack-release.sh",
    "release:all": "node scripts/release-all.mjs",
    "scan": "tsx scripts/scan/cli.ts",
    "peers:refresh": "tsx scripts/peers-refresh.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "4.10.2",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.25.0"
}
