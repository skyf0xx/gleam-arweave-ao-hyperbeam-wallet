{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/android", "destination": "/download?platform=android", "permanent": false },
    { "source": "/android.html", "destination": "/download?platform=android", "permanent": false },
    { "source": "/ios", "destination": "/download?platform=ios", "permanent": false },
    { "source": "/ios.html", "destination": "/download?platform=ios", "permanent": false },
    {
      "source": "/chrome",
      "destination": "https://chromewebstore.google.com/detail/gleam/einabcphdmlicabnjllaaallnebfkmki",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/download", "destination": "/download/index.html" },
    { "source": "/download.html", "destination": "/download/index.html" },
    { "source": "/welcome.html", "destination": "/welcome/index.html" },
    { "source": "/goodbye.html", "destination": "/goodbye/index.html" },
    { "source": "/feedback.html", "destination": "/feedback/index.html" },
    { "source": "/privacy.html", "destination": "/privacy/index.html" },
    { "source": "/terms.html", "destination": "/terms/index.html" },
    { "source": "/security.html", "destination": "/security/index.html" },
    { "source": "/gleam.html", "destination": "/gleam/index.html" },
    { "source": "/invite.html", "destination": "/invite/index.html" },
    { "source": "/points.html", "destination": "/points/index.html" },
    { "source": "/scan.html", "destination": "/scan/index.html" },
    { "source": "/attest.html", "destination": "/attest/index.html" },
    { "source": "/review-results.html", "destination": "/review-results/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'sha256-jnSCccoUJ+wD3OLsWxfdDMuFcHPaRos40/qe/65OxX4=' 'sha256-WZRJfWvsnNCPcxzZwvyhovnZGqhZaC+8gPGPRbx6wTk=' 'sha256-qOhFsq0QMV2REqNwk5hGH5bZE9SkX6gt6yeyKdYPv+U='; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' https://api.gleamwallet.app https://api.web3forms.com https://gateway.umami.is; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
        },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), hid=(), serial=(), bluetooth=(), interest-cohort=()"
        }
      ]
    }
  ]
}
